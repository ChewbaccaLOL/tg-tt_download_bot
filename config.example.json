{
  "download_dir": "./data/downloads",
  "settings_path": "./data/settings.json",
  "default_quality": "compact",
  "max_upload_size_mb": 50,
  "cleanup_after_minutes": 30,
  "yt_dlp_bin": "yt-dlp",
  "ffmpeg_bin": "ffmpeg",
  "allowed_domains": [
    "tiktok.com",
    "vm.tiktok.com",
    "vt.tiktok.com",
    "youtube.com",
    "youtu.be"
  ],
  "access": {
    "mode": "public",
    "whitelist_user_ids": [],
    "paid_download_stars_per_minute": 1,
    "max_paid_duration_minutes": 30
  },
  "compact": {
    "max_height": 720,
    "crf": 28,
    "audio_bitrate": "128k",
    "preset": "veryfast"
  }
}
